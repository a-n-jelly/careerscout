{
  "_docs": "Personal pre-filter rules for filter_roles.py. Copy to my_filters.json (gitignored) and edit. Generated by /feed-setup — updated by /calibrate.",

  "non_role_patterns": [
    "\\bsoftware (development )?engineer\\b",
    "\\bsde\\b",
    "\\brecruiter\\b",
    "\\bdata scientist\\b",
    "\\bintern\\b"
  ],

  "hard_no_title_patterns": [
    {"pattern": "\\bfraud\\b",           "reason": "fraud domain"},
    {"pattern": "\\binfrastructure pm\\b","reason": "infra PM"},
    {"pattern": "\\bproduct manager[,\\s\\-]+growth\\b", "reason": "growth PM"}
  ],

  "skip_companies": [
    {"name": "example corp",  "match": "substring", "reason": "industrial B2B — no consumer surface"},
    {"name": "acme",          "match": "exact",      "reason": "staffing agency"}
  ],

  "exclude_locations": [
    "\\bunited kingdom\\b",
    "\\blondon\\b",
    "\\bcanada\\b",
    "\\bemea\\b"
  ]
}
